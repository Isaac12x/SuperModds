{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "supermodds",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Supermodds post",
        "description": "supermodds",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-post"
      },
      {
        "label": "Create moderator note",
        "description": "Open the starter registered tool form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/starter-note"
      }
    ]
  },
  "forms": {
    "starterNoteForm": "/internal/form/starterNoteForm"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator"
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostUpdate": "/internal/triggers/on-post-update"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "supermodds_dev"
  }
}
