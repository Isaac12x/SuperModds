{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "supermodds",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Supermodds post",
        "description": "supermodds",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-post"
      },
      {
        "label": "Create moderator note",
        "description": "Open the starter registered tool form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/starter-note"
      }
    ]
  },
  "forms": {
    "starterNoteForm": "/internal/form/starterNoteForm"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["api.openai.com"]
    },
    "reddit": {
      "enable": true,
      "scope": "moderator"
    }
  },
  "settings": {
    "global": {
      "openaiApiKey": {
        "type": "string",
        "label": "OpenAI API Key",
        "defaultValue": "",
        "isSecret": true
      },
      "copyrightScanModel": {
        "type": "string",
        "label": "Copyright scan model",
        "defaultValue": "gpt-4.1-mini"
      },
      "adultImageScanModel": {
        "type": "string",
        "label": "+18 image scan model",
        "defaultValue": "gpt-4.1-mini"
      }
    },
    "subreddit": {
      "copyrightMaterialFilterEnabled": {
        "type": "boolean",
        "label": "Enable copyright material filter",
        "defaultValue": true
      },
      "adultImageReviewFilterEnabled": {
        "type": "boolean",
        "label": "Enable +18 image review filter",
        "defaultValue": true
      },
      "newSubredditBotGuardEnabled": {
        "type": "boolean",
        "label": "Enable new subreddit bot guard",
        "defaultValue": true
      },
      "newSubredditBotGuardAccountAgeDays": {
        "type": "number",
        "label": "Bot guard account age threshold in days",
        "defaultValue": 7
      },
      "newSubredditBotGuardMinCombinedKarma": {
        "type": "number",
        "label": "Bot guard minimum combined karma",
        "defaultValue": 25
      },
      "newSubredditBotGuardFirstSeenHours": {
        "type": "number",
        "label": "Bot guard first-seen monitoring window in hours",
        "defaultValue": 24
      },
      "newSubredditBotGuardWindowMinutes": {
        "type": "number",
        "label": "Bot guard activity window in minutes",
        "defaultValue": 10
      },
      "newSubredditBotGuardMaxItemsPerWindow": {
        "type": "number",
        "label": "Bot guard maximum items per window",
        "defaultValue": 3
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onCommentSubmit": "/internal/triggers/on-comment-submit",
    "onPostUpdate": "/internal/triggers/on-post-update"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "supermodds_dev"
  }
}
